rules_version = '2';

// Smit Gym - Firestore Security Rules (private data + social network)
//
// DEPLOY THESE before any real user signs up, and again after this file changes:
//   Firebase Console > Firestore Database > Rules tab > paste > Publish
//   (or: firebase deploy --only firestore:rules --project smith-gymai)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A coach may read a trainee only while the trainee doc still points at
    // that coach AND the linked coachLinks doc is active and really theirs.
    // Ending the link (or clearing it) drops access even if coachUid is stale.
    function isCoachOf(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      let linkDoc = get(/databases/$(database)/documents/coachLinks/$(userDoc.data.coachLinkId));
      return signedIn()
        && userDoc.data.coachUid == request.auth.uid
        && linkDoc.data.traineeUid == userId
        && linkDoc.data.coachUid == request.auth.uid
        && linkDoc.data.status == 'active';
    }

    // The invite named on a new link must already show this trainee as the
    // redeemer after the same batch (getAfter), and must belong to that coach.
    function redeemedInviteMatches(inviteCode, coachUid) {
      let code = getAfter(/databases/$(database)/documents/inviteCodes/$(inviteCode));
      return code.data.usedBy == request.auth.uid
        && code.data.coachUid == coachUid;
    }

    // ── Private data: the owner writes; their coach may read ─────────────
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
      allow write: if signedIn() && request.auth.uid == userId;

      // Progress history (workoutLogs, weightHistory, waterLog…) — the coach
      // needs to read this to see how the trainee is doing, never to write it.
      match /{subcollection=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // ── Coach-authored plans ─────────────────────────────────────────────
    // Kept OUT of the trainee's own document on purpose: the coach gets a
    // whole collection they may write, instead of us trying to police which
    // fields of users/{uid} they're allowed to touch.
    match /users/{userId}/coachPlans/{planId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
      allow create, update, delete: if isCoachOf(userId);
    }

    match /users/{userId}/coachNotes/{noteId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
      allow create, update, delete: if isCoachOf(userId);
    }

    // ── Coach public profile ─────────────────────────────────────────────
    match /coachProfiles/{coachUid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == coachUid;
    }

    // ── The relationship itself ──────────────────────────────────────────
    match /coachLinks/{linkId} {
      allow read: if signedIn() &&
        (resource.data.coachUid == request.auth.uid || resource.data.traineeUid == request.auth.uid);

      // Only the trainee creates the link, and only by redeeming a real code
      // for that coach in the same batch.
      allow create: if signedIn()
        && request.resource.data.traineeUid == request.auth.uid
        && request.resource.data.coachUid is string
        && request.resource.data.coachUid != request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() > 0
        && redeemedInviteMatches(request.resource.data.inviteCode, request.resource.data.coachUid);

      // Either party may end an active link (status + endedAt only).
      // The trainee may also edit permissions. Nothing else, and no re-activate.
      allow update: if signedIn() && (
        (
          (resource.data.coachUid == request.auth.uid || resource.data.traineeUid == request.auth.uid)
          && resource.data.status == 'active'
          && request.resource.data.status == 'ended'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
        )
        ||
        (
          resource.data.traineeUid == request.auth.uid
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions'])
        )
      );
    }

    // ── Invite codes ─────────────────────────────────────────────────────
    // Lookup is by exact id (the code you were handed). Listing every code
    // is denied; a coach may list only their own.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.coachUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      // Redeem once, before expiry, stamping usedBy with your own uid.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && request.resource.data.usedBy == request.auth.uid
        && request.auth.uid != resource.data.coachUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy']);

      allow delete: if signedIn() && resource.data.coachUid == request.auth.uid;
    }

    // Share documents contain a limited snapshot selected by the owner.
    // The random document id acts as the share token. Anyone with the link
    // may get one active, unexpired doc. Listing the collection is not public.
    match /sharedProfiles/{shareId} {
      allow get: if resource.data.status == 'active' && resource.data.expiresAt > request.time;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt is timestamp;

      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Public profiles: signed-in read, owner write, no exact GPS ───────
    // `geohash5` is a coarse cell (~5 km). `location` (exact lat/lng) is rejected.
    // Delete is separate: request.resource does not exist on delete.
    match /publicProfiles/{userId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && !('location' in request.resource.data)
        && request.resource.data.get('geohash5', '') is string
        && request.resource.data.get('geohash5', '').size() <= 5;

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // ── Feed posts: read by all signed-in, create/delete by author only ──
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;

      // Likes: one doc per user, each user manages only their own like
      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == likeUid;
      }
    }

    // ── Buddy requests: visible to the two people involved ───────────────
    match /buddyRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      // Only the recipient can accept/decline
      allow update: if signedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ── Deny everything else ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
