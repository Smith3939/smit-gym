rules_version = '2';

// Smit Gym - Firestore Security Rules (private data + social network)
//
// DEPLOY THESE before any real user signs up:
//   Firebase Console > Firestore Database > Rules tab > paste > Publish
//   (or: firebase deploy --only firestore:rules)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The trainee's own doc records who coaches them. That single field is the
    // whole authorisation story for the coach module — a coach is only ever
    // "my coach" because the trainee accepted an invite, which is the only
    // thing that writes it.
    function isCoachOf(userId) {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(userId)).data.coachUid == request.auth.uid;
    }

    // ── Private data: the owner writes; their coach may read ─────────────
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
      allow write: if signedIn() && request.auth.uid == userId;

      // Progress history (workoutLogs, weightHistory, waterLog…) — the coach
      // needs to read this to see how the trainee is doing, never to write it.
      match /{subcollection=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // ── Coach-authored plans ─────────────────────────────────────────────
    // Kept OUT of the trainee's own document on purpose: the coach gets a
    // whole collection they may write, instead of us trying to police which
    // fields of users/{uid} they're allowed to touch.
    match /users/{userId}/coachPlans/{planId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
      allow create, update, delete: if isCoachOf(userId);
    }

    match /users/{userId}/coachNotes/{noteId} {
      allow read: if signedIn() && (request.auth.uid == userId || isCoachOf(userId));
      allow create, update, delete: if isCoachOf(userId);
    }

    // ── Coach public profile ─────────────────────────────────────────────
    match /coachProfiles/{coachUid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == coachUid;
    }

    // ── The relationship itself ──────────────────────────────────────────
    match /coachLinks/{linkId} {
      allow read: if signedIn() &&
        (resource.data.coachUid == request.auth.uid || resource.data.traineeUid == request.auth.uid);
      // Only the trainee creates the link — that IS the act of consenting.
      allow create: if signedIn() && request.resource.data.traineeUid == request.auth.uid;
      // Either side can end it.
      allow update: if signedIn() &&
        (resource.data.coachUid == request.auth.uid || resource.data.traineeUid == request.auth.uid);
    }

    // ── Invite codes ─────────────────────────────────────────────────────
    // Readable by any signed-in user (you must be able to look up a code you
    // were given), but the document only ever exposes the coach's name.
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.coachUid == request.auth.uid;
      // Redeeming = stamping usedBy with your own uid, once.
      allow update: if signedIn() &&
        resource.data.usedBy == null &&
        request.resource.data.usedBy == request.auth.uid;
      allow delete: if signedIn() && resource.data.coachUid == request.auth.uid;
    }

    // Share documents contain a limited snapshot selected by the owner.
    // The random document id acts as the share token; expired or disabled links are closed.
    match /sharedProfiles/{shareId} {
      allow read: if resource.data.status == 'active' && resource.data.expiresAt > request.time;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Public profiles: any signed-in user may read, only owner writes ──
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // ── Feed posts: read by all signed-in, create/delete by author only ──
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;

      // Likes: one doc per user, each user manages only their own like
      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == likeUid;
      }
    }

    // ── Buddy requests: visible to the two people involved ───────────────
    match /buddyRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      // Only the recipient can accept/decline
      allow update: if signedIn() && resource.data.toUid == request.auth.uid;
      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ── Deny everything else ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
