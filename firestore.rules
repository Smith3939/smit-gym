rules_version = '2';

// Smit Gym - Firestore Security Rules
//
// DEPLOY THESE before any real user signs up. Currently the database is in
// "test mode" (open to the world). To deploy:
//   1. Firebase Console > Firestore Database > Rules tab
//   2. Paste this file's contents, click "Publish"
//   (or: firebase deploy --only firestore:rules with the Firebase CLI)

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only read/write their own profile document and its subcollections
    // (weightHistory, workoutLogs, waterLog, etc.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Share documents contain a limited snapshot selected by the owner.
    // The random document id acts as the share token; expired or disabled links are closed.
    match /sharedProfiles/{shareId} {
      allow read: if resource.data.status == 'active' && resource.data.expiresAt > request.time;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
